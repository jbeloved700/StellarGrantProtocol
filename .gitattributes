# Language Detection Configuration
# Ensures accurate language percentage display on GitHub

# Explicitly set Rust for contracts
*.rs linguist-language=Rust

# Explicitly set TypeScript for web, client, backend
*.tsx linguist-language=TypeScript
web/*.ts linguist-language=TypeScript
web/**/*.ts linguist-language=TypeScript
web/**/*.tsx linguist-language=TypeScript
client/*.ts linguist-language=TypeScript
client/**/*.ts linguist-language=TypeScript
backend/*.ts linguist-language=TypeScript
backend/**/*.ts linguist-language=TypeScript

# Exclude vendored dependencies from stats
node_modules/ linguist-vendored
**/node_modules/ linguist-vendored
target/ linguist-vendored
**/target/ linguist-vendored

# Exclude generated files
dist/ linguist-generated
build/ linguist-generated
.next/ linguist-generated
coverage/ linguist-generated
**/.next/ linguist-generated

# Exclude lock files from counting
package-lock.json linguist-vendored
Cargo.lock linguist-vendored

# Exclude environment files
.env* linguist-vendored

# Mark WASM as generated
*.wasm linguist-generated

# Mark docs appropriately
*.md linguist-documentation
README.md linguist-documentation
ARCHITECTURE.md linguist-documentation
CONTRIBUTING.md linguist-documentation
